{
  "name": "veilgraph-browser-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "python3 scripts/build.py",
    "verify:visual": "npm run build && node scripts/verify_visual_layer.mjs",
    "verify:perception": "npm run build && node scripts/verify_perception_contract.mjs && node scripts/verify_visual_layer.mjs",
    "verify:learned": "npm run build && node scripts/verify_learned_model_contract.mjs",
    "verify:action-plan": "npm run build && node scripts/verify_action_plan_contract.mjs",
    "verify:local-action": "npm run build && node scripts/verify_local_action_contract.mjs",
    "verify:agent-loop": "npm run build && node scripts/verify_agent_loop_contract.mjs",
    "build:firefox": "npm run build && python3 scripts/build_firefox.py",
    "verify:firefox": "npm run build:firefox && node scripts/verify_firefox_package.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "onnxruntime-web": "1.27.0"
  }
}
